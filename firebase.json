{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "cd \"$RESOURCE_DIR\" && npm run lint",
        "cd \"$RESOURCE_DIR\" && npm run build"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/dist/**/.git"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
