VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Local development only (see src/devAuth.ts) ----------------------------
# Telegram id to sign in as when the app runs in a normal browser instead of
# inside Telegram (your own id, e.g. from @userinfobot). Leave empty to disable
# the local login. Ignored by production builds and when opened via Telegram.
VITE_TELEGRAM_ID=

# "true" to make the client talk to the local emulator suite (Auth :9099,
# Firestore :8080, Functions :5001) instead of the cloud project. Requires the
# emulators to be running — see README "Local development without Telegram".
VITE_USE_EMULATORS=

# --- Telegram -----------------------------------------------------------------
# Bot (@handle) that hosts the Mini App, and its Mini App short name. Browser
# visitors who are not in Telegram are sent to t.me/<bot>/<app>. Defaults to
# BirdEnergy_testbot / birdenergygame, so both can stay empty.
VITE_TELEGRAM_BOT_USERNAME=
VITE_TELEGRAM_APP_NAME=