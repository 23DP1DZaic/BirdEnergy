# Copy to functions/.env (gitignored) and fill in the real values.
# TELEGRAM_BOT_TOKEN: token from @BotFather for the bot that hosts the Mini App
# (BirdEnergy_testbot). Used by authenticateTelegram to verify initData HMAC.
TELEGRAM_BOT_TOKEN=

# ADMIN_TELEGRAM_IDS: comma-separated Telegram user ids that get the "admin"
# role (resolved server-side in authenticateTelegram, AUTH-03). Your own id
# is visible e.g. via the authenticateTelegram response or @userinfobot.
ADMIN_TELEGRAM_IDS=
