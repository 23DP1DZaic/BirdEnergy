rules_version = '2';

// SEC-01 — BirdEnergy Firestore security rules.
//
// Model:
//  - users/{uid}: one profile doc per player, uid is `tg-<telegramId>`.
//    * The owner may READ their own profile (the app shows "your data" state).
//    * WRITES happen only server-side (Cloud Functions via the Admin SDK —
//      authenticateTelegram / acceptDataProcessing / submitGameResult later),
//      because identity, consent and scores must never be trusted from the
//      client. The Admin SDK bypasses these rules by design.
//    * No public reads yet: the leaderboard (DATA-02/UI-03) will be served by
//      a Cloud Function or a rules change when it actually exists — until then
//      other players' profiles (telegram ids) stay private.
//  - Everything else: closed until a backlog card needs it.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      // Owner-only read; create/update/delete stay server-only.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    // CH-01 — the Challenges screen reads the whole challenge list (sorted
    // startDate desc, client-side search/filter per the spec). Writes stay
    // denied: ADM-01's adminChallengeMutation is the only writer (Admin SDK
    // bypasses these rules by design).
    match /challenges/{challengeId} {
      allow get, list: if request.auth != null;
      allow write: if false;
    }

    // CH-01 — challenge progress is computed from gameResults with no separate
    // challengeProgress collection (backlog DoD). A player may list only
    // THEIR OWN runs: the query must filter where('uid', auth.uid), which is
    // exactly what the client does (rules provably reject unscoped queries).
    // Writes happen only server-side in submitGameResult.
    match /gameResults/{resultId} {
      allow list: if request.auth != null && request.auth.uid == resource.data.uid;
      allow get, write: if false;
    }

    // Default deny for any other path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
